#!/usr/bin/env python3
"""Lanzador de la herramienta `cougar` desde el propio kit (sin instalar nada).

    ./herramientas/cougar listar
    ./herramientas/cougar conn
    ./herramientas/cougar --device /dev/pts/3 subir fondo.png

Instalado con `herramientas/instalar.sh`, la orden es simplemente `cougar`.
"""

import os
import sys

RAIZ = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
sys.path.insert(0, RAIZ)

from cougar.cli import main    # noqa: E402

if __name__ == "__main__":
    sys.exit(main())
