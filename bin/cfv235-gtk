#!/usr/bin/env python3
"""Lanzador de la aplicacion de escritorio del panel LCD COUGAR CFV235.

Se puede ejecutar desde cualquier sitio: anade la raiz del proyecto al sys.path para
que `cfv235` y `cfv235_gtk` se encuentren aunque no esten instalados.
"""

import os
import sys

RAIZ = os.path.dirname(os.path.dirname(os.path.realpath(__file__)))
if RAIZ not in sys.path:
    sys.path.insert(0, RAIZ)

from cfv235_gtk.app import main  # noqa: E402

if __name__ == "__main__":
    sys.exit(main())
